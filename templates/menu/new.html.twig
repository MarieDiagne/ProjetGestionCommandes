{% extends 'base.html.twig' %}

{% block title %}Nouveau Menu{% endblock %}
{% block page_title %}Créer un nouveau menu{% endblock %}

{% block stylesheets %}
<style>
    /* Configuration du design Premium */
    :root {
        --glass-bg: rgba(255, 255, 255, 0.95);
        --primary-gradient: linear-gradient(135deg, #ff4757, #ff6b81);
        --dark-accent: #2d3436;
        --info-gradient: linear-gradient(135deg, #74b9ff, #0984e3);
    }

    body {
        background: #f0f2f5;
    }

    /* Animation d'entrée */
    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .row.justify-content-center {
        animation: fadeInUp 0.6s ease-out;
    }

    /* Carte stylisée */
    .card {
        border: none;
        border-radius: 24px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.06);
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.8);
    }

    .card-header {
        background: var(--dark-accent) !important;
        color: white;
        padding: 2rem !important;
        border: none;
        text-align: center;
    }

    .card-header h5 {
        font-size: 1.5rem;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    /* Alerte de composition stylisée */
    .alert-composition {
        background: var(--info-gradient);
        color: white;
        border: none;
        border-radius: 15px;
        padding: 1rem;
        margin-bottom: 2rem;
        font-weight: 500;
        box-shadow: 0 4px 15px rgba(9, 132, 227, 0.2);
    }

    /* Champs de saisie modernes */
    .form-label {
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        color: #b2bec3;
        margin-left: 5px;
        margin-bottom: 8px;
        letter-spacing: 1px;
    }

    .form-control, .form-select {
        border-radius: 16px;
        padding: 0.9rem 1.2rem;
        border: 2px solid #edf2f7;
        background-color: #f8fafc;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        font-size: 1rem;
    }

    .form-control:focus, .form-select:focus {
        background-color: #fff;
        border-color: #ff4757;
        box-shadow: 0 10px 20px rgba(255, 71, 87, 0.1);
        transform: translateY(-2px);
    }

    /* Boutons stylisés */
    .btn-danger {
        background: var(--primary-gradient);
        border: none;
        padding: 1rem 2rem;
        border-radius: 18px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        box-shadow: 0 8px 25px rgba(255, 71, 87, 0.3);
        transition: all 0.4s;
    }

    .btn-danger:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 30px rgba(255, 71, 87, 0.4);
        filter: brightness(1.1);
    }

    .btn-outline-secondary {
        border: 2px solid #dfe6e9;
        color: #636e72;
        padding: 1rem 2rem;
        border-radius: 18px;
        font-weight: 600;
        transition: all 0.3s;
    }

    .btn-outline-secondary:hover {
        background: #f1f2f6;
        color: #2d3436;
        border-color: #b2bec3;
    }

    /* Breadcrumb */
    .breadcrumb {
        background: transparent;
        padding: 0;
    }
    .breadcrumb-item a { color: #ff4757; font-weight: 600; text-decoration: none; }
    .breadcrumb-item.active { color: #b2bec3; }
</style>
{% endblock %}

{% block body %}
    <nav aria-label="breadcrumb" class="mb-5">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="{{ path('app_menu_index') }}">Menus</a>
            </li>
            <li class="breadcrumb-item active">Nouvelle Composition</li>
        </ol>
    </nav>

    <div class="row justify-content-center mb-5">
        <div class="col-md-8 col-lg-7">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-stars me-2"></i>
                        CRÉER UN MENU
                    </h5>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form method="post" action="{{ path('app_menu_new') }}" enctype="multipart/form-data">
                        <input type="hidden" name="_token" value="{{ csrf_token('create_menu') }}">

                        <div class="mb-4">
                            <label for="libelle" class="form-label">Nom du menu <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="libelle" name="libelle" required placeholder="Ex: Menu Duo Signature">
                        </div>

                        <div class="alert-composition d-flex align-items-center">
                            <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                            <div>
                                <strong>Composition :</strong> Sélectionnez un burger, une boisson et une portion de frites.
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12 mb-4">
                                <label for="burger_id" class="form-label">Burger Premium <span class="text-danger">*</span></label>
                                <select class="form-select" id="burger_id" name="burger_id" required>
                                    <option value="">-- Choisir un burger --</option>
                                    {% for burger in burgers %}
                                        <option value="{{ burger.id }}">{{ burger.libelle }} ({{ burger.prix|number_format(0, ',', ' ') }} FCFA)</option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label for="boisson_id" class="form-label">Boisson <span class="text-danger">*</span></label>
                                <select class="form-select" id="boisson_id" name="boisson_id" required>
                                    <option value="">-- Choisir --</option>
                                    {% for boisson in boissons %}
                                        <option value="{{ boisson.id }}">{{ boisson.libelle }}</option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label for="frite_id" class="form-label">Frites <span class="text-danger">*</span></label>
                                <select class="form-select" id="frite_id" name="frite_id" required>
                                    <option value="">-- Choisir --</option>
                                    {% for frite in frites %}
                                        <option value="{{ frite.id }}">{{ frite.libelle }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>

                        <div class="mb-5">
                            <label for="image" class="form-label">Image publicitaire du menu</label>
                            <input type="file" class="form-control" id="image" name="image" accept="image/*">
                            <small class="form-text text-muted ps-2 mt-2 d-block">Format recommandé : PNG ou JPG (Max 5 Mo)</small>
                        </div>

                        <div class="d-grid gap-3 d-md-flex justify-content-md-center">
                            <button type="submit" class="btn btn-danger px-5">
                                <i class="bi bi-check-lg me-2"></i>
                                Enregistrer le Menu
                            </button>
                            <a href="{{ path('app_menu_index') }}" class="btn btn-outline-secondary px-5">
                                Annuler
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}