{% extends 'base.html.twig' %}

{% block title %}Gestion des Menus{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --burger-red: #e63946;
        --burger-dark: #1d3557;
        --burger-light: #f8f9fa;
        --menu-blue: #457b9d;
    }

    .page-header {
        background: linear-gradient(135deg, var(--burger-dark), #2b4d7a);
        color: white;
        padding: 2rem;
        border-radius: 15px;
        margin-bottom: 2rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .menu-card {
        border: none;
        border-radius: 20px;
        transition: all 0.3s ease;
        overflow: hidden;
        background: white;
    }

    .menu-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
    }

    .img-container {
        position: relative;
        height: 200px;
        overflow: hidden;
        background-color: #f1f3f5;
    }

    .img-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .menu-card:hover .img-container img {
        transform: scale(1.1);
    }

    .price-tag {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--burger-red);
    }

    .composition-badge {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 700;
        color: var(--menu-blue);
    }

    .btn-add {
        background-color: var(--burger-red);
        border: none;
        padding: 10px 25px;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-add:hover {
        background-color: #c92a35;
        transform: scale(1.05);
        box-shadow: 0 5px 15px rgba(230, 57, 70, 0.4);
    }

    .archived-overlay {
        filter: grayscale(100%);
        opacity: 0.7;
    }

    .composition-item {
        font-size: 0.85rem;
        color: #495057;
        display: flex;
        align-items: center;
        gap: 8px;
    }
</style>
{% endblock %}

{% block body %}
<div class="container py-5">
    
    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 mb-1 fw-bold">Gestion des Menus</h1>
            <p class="mb-0 opacity-75">Créez et gérez vos formules complètes</p>
        </div>
        <a href="{{ path('app_menu_new') }}" class="btn btn-danger btn-add">
            <i class="bi bi-plus-lg me-2"></i>Nouveau Menu
        </a>
    </div>

    <div class="row">
        {% if menus is empty %}
            <div class="col-12 text-center py-5">
                <div class="card border-0 shadow-sm py-5 rounded-4">
                    <div class="card-body">
                        <i class="bi bi-box-seam text-muted display-1"></i>
                        <h3 class="mt-4 fw-bold">Aucun menu trouvé</h3>
                        <p class="text-muted">Proposez des formules (Burger + Boisson + Frite) à vos clients.</p>
                        <a href="{{ path('app_menu_new') }}" class="btn btn-outline-danger rounded-pill mt-2">
                            Créer mon premier menu
                        </a>
                    </div>
                </div>
            </div>
        {% else %}
            {% for menu in menus %}
                <div class="col-sm-6 col-lg-4 col-xl-3 mb-4">
                    <div class="card h-100 menu-card shadow-sm {% if menu.isArchived %}archived-overlay{% endif %}">
                        
                        <div class="img-container">
                            {% if menu.isArchived %}
                                <div class="position-absolute top-0 start-0 m-3 z-3">
                                    <span class="badge bg-dark rounded-pill shadow-sm">Archivé</span>
                                </div>
                            {% endif %}
                            
                            {% if menu.imageUrl %}
                                <img src="{{ menu.imageUrl }}" alt="{{ menu.libelle }}">
                            {% else %}
                                <div class="bg-light d-flex flex-column align-items-center justify-content-center h-100">
                                    <i class="bi bi-box-seam text-muted mb-2" style="font-size: 2.5rem;"></i>
                                    <span class="text-muted small fw-bold">🍔 + 🥤 + 🍟</span>
                                </div>
                            {% endif %}
                        </div>

                        <div class="card-body d-flex flex-column">
                            <div class="mb-3">
                                <span class="composition-badge">Formule Complète</span>
                                <h5 class="card-title fw-bold mb-0 text-dark">{{ menu.libelle }}</h5>
                            </div>

                            <div class="flex-grow-1">
                                <div class="composition-item mb-1">
                                    <i class="bi bi-check2-circle text-danger"></i> {{ menu.burger.libelle }}
                                </div>
                                <div class="composition-item mb-1">
                                    <i class="bi bi-cup-straw text-info"></i> {{ menu.boisson.libelle }}
                                </div>
                                <div class="composition-item mb-1">
                                    <i class="bi bi-fry-cook text-warning"></i> {{ menu.frite.libelle }}
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                <span class="price-tag">{{ menu.prixTotal|number_format(0, ',', ' ') }} <small class="fs-6">FCFA</small></span>
                                
                                <div class="d-flex gap-1">
                                    <a href="{{ path('app_menu_edit', {id: menu.id}) }}" class="btn btn-light btn-sm rounded-circle shadow-sm" title="Modifier">
                                        <i class="bi bi-pencil-fill text-primary"></i>
                                    </a>
                                    
                                    <form method="post" action="{{ path('app_menu_archive', {id: menu.id}) }}" onsubmit="return confirm('Êtes-vous sûr ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('archive_menu_' ~ menu.id) }}">
                                        <button type="submit" class="btn btn-light btn-sm rounded-circle shadow-sm" title="{{ menu.isArchived ? 'Restaurer' : 'Archiver' }}">
                                            {% if menu.isArchived %}
                                                <i class="bi bi-arrow-counterclockwise text-success"></i>
                                            {% else %}
                                                <i class="bi bi-archive-fill text-warning"></i>
                                            {% endif %}
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>
</div>
{% endblock %}