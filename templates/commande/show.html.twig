{% extends 'base.html.twig' %}

{% block title %}Commande #{{ commande.numeroCommande }}{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --dark-bg: #0f172a;
        --soft-gray: #f8fafc;
    }

    /* Breadcrumb stylisé */
    .breadcrumb-item a { color: #64748b; text-decoration: none; font-weight: 600; }
    .breadcrumb-item.active { color: #ef4444; font-weight: 700; }

    /* Entête de commande */
    .order-header-card {
        background: white;
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 15px -3px rgba(0,0,0,0.05);
        border-left: 5px solid #ef4444;
    }

    /* Badges Modernes */
    .badge-status {
        padding: 8px 16px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .bg-soft-warning { background: #fffbeb; color: #92400e; }
    .bg-soft-success { background: #f0fdf4; color: #166534; }
    .bg-soft-info { background: #f0f9ff; color: #0369a1; }
    .bg-soft-danger { background: #fef2f2; color: #991b1b; }
    .bg-soft-primary { background: #eef2ff; color: #3730a3; }

    /* Table des produits */
    .product-table thead th {
        background: var(--soft-gray);
        border: none;
        color: #64748b;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 15px;
    }

    .product-table tbody td {
        padding: 15px;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }

    /* Section Actions (Sidebar droite) */
    .action-card {
        border: none;
        border-radius: 20px;
        background: white;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
    }

    .info-label {
        font-size: 0.7rem;
        font-weight: 800;
        color: #94a3b8;
        text-transform: uppercase;
        display: block;
        margin-bottom: 2px;
    }

    .total-box {
        background: #f8fafc;
        border-radius: 15px;
        padding: 20px;
        border: 1px dashed #cbd5e1;
    }
</style>
{% endblock %}

{% block body %}
	<nav aria-label="breadcrumb" class="mb-4">
		<ol class="breadcrumb">
			<li class="breadcrumb-item"><a href="{{ path('app_commande_index') }}">Journal</a></li>
			<li class="breadcrumb-item active">Commande #{{ commande.numeroCommande }}</li>
		</ol>
	</nav>

	<div class="row g-4">
		<div class="col-lg-8">
			<div class="card order-header-card mb-4">
				<div class="card-body p-4">
					<div class="d-flex justify-content-between align-items-start mb-4">
						<div>
							<span class="info-label">Référence Commande</span>
							<h3 class="fw-800 mb-0">#{{ commande.numeroCommande }}</h3>
							<span class="text-muted small"><i class="bi bi-calendar3 me-1"></i> {{ commande.dateCommande|date('d F Y à H:i') }}</span>
						</div>
						{% set badgeStyle = {
    						'EN_ATTENTE': 'warning', 'VALIDEE': 'success', 'EN_PREPARATION': 'info',
    						'TERMINEE': 'primary', 'EN_LIVRAISON': 'info', 'LIVREE': 'success', 'ANNULEE': 'danger'
						} %}
						<span class="badge-status bg-soft-{{ badgeStyle[commande.etat] ?? 'secondary' }}">
							{{ commande.etat|replace({'_': ' '}) }}
						</span>
					</div>

					<div class="row g-3">
						<div class="col-sm-6">
							<div class="p-3 rounded-4 border bg-light bg-opacity-50">
								<span class="info-label">Informations Client</span>
								<h6 class="fw-bold mb-1">{{ commande.client.prenom }} {{ commande.client.nom }}</h6>
								<div class="text-muted small">
                                    <i class="bi bi-telephone me-1"></i> {{ commande.client.tel }}<br>
                                    <i class="bi bi-envelope me-1"></i> {{ commande.client.email }}
                                </div>
							</div>
						</div>
						<div class="col-sm-6">
							<div class="p-3 rounded-4 border bg-light bg-opacity-50">
								<span class="info-label">Mode & Logistique</span>
								{% if commande.modeConsommation == 'SUR_PLACE' %}
									<span class="badge bg-info-subtle text-info rounded-pill px-3">Sur place</span>
								{% elseif commande.modeConsommation == 'A_EMPORTER' %}
									<span class="badge bg-warning-subtle text-warning rounded-pill px-3">À emporter</span>
								{% else %}
									<span class="badge bg-primary-subtle text-primary rounded-pill px-3 mb-2">Livraison à domicile</span>
                                    {% if commande.adresseLivraison %}
                                        <div class="small text-muted"><i class="bi bi-geo-alt me-1"></i> {{ commande.adresseLivraison }}</div>
                                    {% endif %}
								{% endif %}
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
				<div class="card-header bg-white py-3">
					<h6 class="mb-0 fw-bold"><i class="bi bi-bag-check me-2 text-danger"></i>Panier de la commande</h6>
				</div>
				<div class="card-body p-0">
					<div class="table-responsive">
						<table class="table product-table mb-0">
							<thead>
								<tr>
									<th>Désignation du produit</th>
									<th class="text-center">Qté</th>
									<th class="text-end">Prix Unit.</th>
									<th class="text-end">Sous-total</th>
								</tr>
							</thead>
							<tbody>
								{% for ligne in commande.lignesCommande %}
									<tr>
										<td>
											<div class="d-flex align-items-center">
												{% if ligne.typeProduit == 'BURGER' %}
													<div class="bg-danger bg-opacity-10 p-2 rounded-3 me-3 text-danger"><i class="bi bi-egg-fried"></i></div>
												{% elseif ligne.typeProduit == 'MENU' %}
													<div class="bg-success bg-opacity-10 p-2 rounded-3 me-3 text-success"><i class="bi bi-box-seam"></i></div>
												{% else %}
													<div class="bg-info bg-opacity-10 p-2 rounded-3 me-3 text-info"><i class="bi bi-plus-lg"></i></div>
												{% endif %}
												<div>
													<div class="fw-bold text-dark">
                                                        {{ ligne.burger.libelle ?? ligne.menu.libelle ?? ligne.complement.libelle }}
                                                    </div>
													<span class="text-muted" style="font-size: 0.7rem;">{{ ligne.typeProduit }}</span>
												</div>
											</div>
										</td>
										<td class="text-center fw-bold">×{{ ligne.quantite }}</td>
										<td class="text-end text-muted small">{{ ligne.prixUnitaire|number_format(0, ',', ' ') }} FCFA</td>
										<td class="text-end fw-bold text-dark">{{ ligne.sousTotal|number_format(0, ',', ' ') }} FCFA</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
                    <div class="p-4 bg-light bg-opacity-50">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-muted">MONTANT TOTAL À RÉGLER</span>
                            <h3 class="text-danger fw-800 mb-0">{{ commande.montantTotal|number_format(0, ',', ' ') }} <small class="fs-6">FCFA</small></h3>
                        </div>
                    </div>
				</div>
			</div>
		</div>

		<div class="col-lg-4">
			<div class="card action-card mb-4">
				<div class="card-header bg-white py-3">
					<h6 class="mb-0 fw-bold"><i class="bi bi-lightning-stars me-2 text-warning"></i>Gestion d'état</h6>
				</div>
				<div class="card-body">
					{% if commande.etat not in ['ANNULEE', 'LIVREE'] %}
						<form method="post" action="{{ path('app_commande_changer_etat', {id: commande.id}) }}" class="mb-3">
							<input type="hidden" name="_token" value="{{ csrf_token('changer_etat_' ~ commande.id) }}">
							<label class="info-label mb-2">Mettre à jour le statut</label>
							<select name="etat" class="form-select form-select-lg mb-3 border-2" style="font-size: 0.9rem; font-weight: 600;">
								<option value="EN_ATTENTE" {% if commande.etat == 'EN_ATTENTE' %} selected {% endif %}>⏳ En attente</option>
								<option value="VALIDEE" {% if commande.etat == 'VALIDEE' %} selected {% endif %}>✅ Validée</option>
								<option value="EN_PREPARATION" {% if commande.etat == 'EN_PREPARATION' %} selected {% endif %}>👨‍🍳 En préparation</option>
								<option value="TERMINEE" {% if commande.etat == 'TERMINEE' %} selected {% endif %}>🏁 Terminée</option>
								{% if commande.modeConsommation == 'LIVRAISON' %}
									<option value="EN_LIVRAISON" {% if commande.etat == 'EN_LIVRAISON' %} selected {% endif %}>🛵 En livraison</option>
									<option value="LIVREE" {% if commande.etat == 'LIVREE' %} selected {% endif %}>🏠 Livrée</option>
								{% endif %}
							</select>
							<button type="submit" class="btn btn-dark w-100 py-3 fw-bold rounded-4 shadow-sm">
								Appliquer le changement
							</button>
						</form>
					{% endif %}

					{% if commande.etat not in ['TERMINEE', 'LIVREE', 'ANNULEE'] %}
						<form method="post" action="{{ path('app_commande_annuler', {id: commande.id}) }}" onsubmit="return confirm('Confirmer l\'annulation définitive ?');">
							<input type="hidden" name="_token" value="{{ csrf_token('annuler_commande_' ~ commande.id) }}">
							<button type="submit" class="btn btn-outline-danger w-100 border-2 fw-bold rounded-4">
								<i class="bi bi-x-lg me-2"></i>Annuler la commande
							</button>
						</form>
					{% endif %}

					<a href="{{ path('app_commande_index') }}" class="btn btn-link w-100 mt-3 text-decoration-none text-muted fw-bold small">
						<i class="bi bi-arrow-left me-2"></i>Retour au journal
					</a>
				</div>
			</div>

			<div class="card action-card border-0 bg-dark text-white p-4">
				<h6 class="fw-bold mb-3"><i class="bi bi-info-circle me-2"></i>Traçabilité</h6>
				<div class="mb-3">
					<span class="info-label text-white-50">Ouverture du dossier</span>
					<div class="small fw-bold">{{ commande.createdAt|date('d/m/Y - H:i') }}</div>
				</div>
				<div>
					<span class="info-label text-white-50">Dernière activité</span>
					<div class="small fw-bold">{{ commande.updatedAt|date('d/m/Y - H:i') }}</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}