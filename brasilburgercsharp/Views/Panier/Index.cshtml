@model brasilburgercsharp.ViewModels.Panier.PanierViewModel

<div class="container mt-5">
    <h3>Votre Panier 🛒</h3>
    
    @if (Model == null || !Model.Lignes.Any()) {
        <div class="alert alert-info mt-3">
            Votre panier est vide. <a asp-controller="Catalogue" asp-action="Index" class="alert-link">Retourner au menu</a>
        </div>
    } else {
        <ul class="list-group mb-3 mt-4 shadow-sm">
            @foreach (var item in Model.Lignes) {
                <li class="list-group-item d-flex justify-content-between lh-sm">
                    <div>
                        <h6 class="my-0">@item.NomProduit</h6>
                        <small class="text-muted">Quantité: @item.Quantite x @item.Prix.ToString("N0") CFA</small>
                    </div>
                    @* CHANGEMENT : item.Prix au lieu de item.PrixUnitaire *@
                    <span class="text-muted fw-bold">@(item.Prix * item.Quantite) CFA</span>
                </li>
            }
            <li class="list-group-item d-flex justify-content-between bg-light">
                <span class="fw-bold">Total (CFA)</span>
                <strong class="text-primary fs-5">@Model.Total.ToString("N0") CFA</strong>
            </li>
        </ul>
        
        <div class="d-grid gap-2">
            <a asp-controller="Commande" asp-action="Passer" class="btn btn-warning btn-lg">Procéder au paiement</a>
            <a asp-controller="Catalogue" asp-action="Index" class="btn btn-outline-secondary">Continuer mes achats</a>
        </div>
    }
</div>