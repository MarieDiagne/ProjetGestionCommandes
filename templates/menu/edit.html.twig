{% extends 'base.html.twig' %}

{% block title %}Modifier le menu{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --burger-dark: #212529;
        --burger-red: #dc3545;
    }
    .form-card {
        transition: all 0.3s ease;
        border: 1px solid rgba(0,0,0,0.05) !important;
    }
    .form-label {
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #6c757d;
        margin-bottom: 0.5rem;
    }
    .form-control, .form-select {
        border: 2px solid #f8f9fa;
        padding: 0.75rem 1.25rem;
        background-color: #f8f9fa;
        transition: all 0.2s ease-in-out;
    }
    .form-control:focus, .form-select:focus {
        background-color: #fff;
        border-color: var(--burger-red);
        box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.1);
    }
    .btn-save {
        background-color: var(--burger-red);
        border: none;
        font-weight: 600;
        transition: transform 0.2s;
    }
    .btn-save:hover {
        background-color: #bb2d3b;
        transform: translateY(-1px);
    }
    .current-image-preview {
        border: 2px solid #f1f2f6;
        padding: 4px;
        background: #fff;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }
    .composition-badge {
        background-color: #f8f9fa;
        border-left: 4px solid var(--burger-red);
        padding: 10px 15px;
        margin-bottom: 1.5rem;
        font-size: 0.9rem;
        color: #495057;
    }
</style>
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb small">
                    <li class="breadcrumb-item"><a href="{{ path('app_menu_index') }}" class="text-muted">Menus</a></li>
                    <li class="breadcrumb-item active text-danger fw-bold">Modification</li>
                </ol>
            </nav>

            <div class="card shadow-lg border-0 rounded-4 form-card">
                <div class="card-header bg-dark text-white p-4 border-0 rounded-top-4">
                    <div class="d-flex align-items-center">
                        <div class="bg-danger rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                            <i class="bi bi-pencil-fill fs-5"></i>
                        </div>
                        <div>
                            <h3 class="mb-0 fw-bold fs-4">Modifier le menu</h3>
                            <p class="text-white-50 mb-0 small text-uppercase fw-bold" style="letter-spacing: 1px;">
                                {{ menu.libelle }}
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="card-body p-4 p-lg-5">
                    <form method="POST" action="{{ path('app_menu_edit', {id: menu.id}) }}" enctype="multipart/form-data">
                        <input type="hidden" name="_token" value="{{ csrf_token('edit_menu_' ~ menu.id) }}">

                        <div class="mb-4">
                            <label for="libelle" class="form-label">Nom du Menu</label>
                            <input type="text" name="libelle" id="libelle" class="form-control rounded-pill" value="{{ menu.libelle }}" required>
                        </div>

                        <div class="composition-badge">
                            <i class="bi bi-info-circle-fill me-2 text-danger"></i>
                            Ajustez la composition de votre formule ci-dessous.
                        </div>

                        <div class="mb-4">
                            <label for="burger_id" class="form-label">Burger Sélectionné</label>
                            <select name="burger_id" id="burger_id" class="form-select rounded-pill" required>
                                {% for burger in burgers %}
                                    <option value="{{ burger.id }}" {% if menu.burger and menu.burger.id == burger.id %} selected {% endif %}>
                                        {{ burger.libelle }} ({{ burger.prix|number_format(0, ',', ' ') }} FCFA)
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label for="boisson_id" class="form-label">Boisson</label>
                                <select name="boisson_id" id="boisson_id" class="form-select rounded-pill" required>
                                    {% for boisson in boissons %}
                                        <option value="{{ boisson.id }}" {% if menu.boisson and menu.boisson.id == boisson.id %} selected {% endif %}>
                                            {{ boisson.libelle }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                            
                            <div class="col-md-6 mb-4">
                                <label for="frite_id" class="form-label">Accompagnement</label>
                                <select name="frite_id" id="frite_id" class="form-select rounded-pill" required>
                                    {% for frite in frites %}
                                        <option value="{{ frite.id }}" {% if menu.frite and menu.frite.id == frite.id %} selected {% endif %}>
                                            {{ frite.libelle }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>

                        <div class="mb-5 p-3 rounded-4 bg-light border border-white">
                            <label for="image" class="form-label">Changer l'image du menu</label>
                            <input type="file" name="image" id="image" class="form-control rounded-pill border-0 shadow-sm" accept="image/*">
                            
                            {% if menu.imageUrl %}
                                <div class="mt-3 d-flex align-items-center gap-3">
                                    <img src="{{ menu.imageUrl }}" alt="Aperçu" class="rounded-3 current-image-preview" style="height: 70px; width: 70px; object-fit: cover;">
                                    <div>
                                        <small class="text-muted d-block">Image publicitaire actuelle</small>
                                        <span class="badge bg-white text-dark border rounded-pill">Aperçu en ligne</span>
                                    </div>
                                </div>
                            {% endif %}
                            <small class="text-muted d-block mt-2 px-2" style="font-size: 0.75rem;">Laissez vide pour conserver l'image actuelle.</small>
                        </div>

                        <div class="d-flex flex-column flex-sm-row gap-3 pt-2">
                            <button type="submit" class="btn btn-danger btn-save px-5 rounded-pill py-2 flex-grow-1">
                                <i class="bi bi-check-lg me-2"></i>Enregistrer les modifications
                            </button>
                            <a href="{{ path('app_menu_index') }}" class="btn btn-outline-secondary px-4 rounded-pill py-2">
                                Annuler
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}