@model brasilburgercsharp.Models.Entities.Produit

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6">
            <img src="@Model.Image" class="img-fluid rounded shadow">
        </div>
        <div class="col-md-6">
            <h1>@Model.Nom</h1>
            <h3 class="text-danger">@Model.Prix CFA</h3>
            <p class="mt-4">Description du produit savoureux de Brasil Burger...</p>
            
            <form asp-controller="Panier" asp-action="Ajouter" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-success btn-lg mt-3">Ajouter au panier</button>
            </form>
            <a asp-action="Index" class="btn btn-secondary btn-lg mt-3">Retour au menu</a>
        </div>
    </div>
</div>