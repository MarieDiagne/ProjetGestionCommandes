<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Connexion - Brasil Burger Gestionnaire</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
        
        <style>
            body {
                font-family: 'Poppins', sans-serif;
                /* Dégradé plus "vif" et gourmand */
                background:  #1e293b;
                min-height: 100vh;
                display: flex;
                align-items: center;
                color: #2d3436;
            }
            
            .login-card {
                background: rgba(255, 255, 255, 0.95);
                border: none;
                border-radius: 25px;
                box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
                overflow: hidden;
            }

            .login-header {
                background: #ffffff;
                color: #d63031;
                padding: 2.5rem 2rem 1rem 2rem;
            }

            .brand-logo {
                font-size: 3rem;
                display: block;
                margin-bottom: 0.5rem;
                filter: drop-shadow(0 4px 6px rgba(0,0,0,0.1));
            }

            .form-control {
                border-radius: 12px;
                padding: 0.75rem 1.2rem;
                border: 2px solid #f1f2f6;
                transition: all 0.3s ease;
            }

            .form-control:focus {
                border-color: #ff9a44;
                box-shadow: 0 0 0 0.25rem rgba(255, 154, 68, 0.15);
            }

            .btn-login {
                background: linear-gradient(45deg, #d63031, #ff7675);
                border: none;
                border-radius: 12px;
                padding: 14px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1px;
                transition: all 0.3s ease;
            }

            .btn-login:hover {
                transform: scale(1.02);
                box-shadow: 0 8px 20px rgba(214, 48, 49, 0.4);
                background: linear-gradient(45deg, #ff7675, #d63031);
            }

            .form-label {
                font-weight: 600;
                color: #636e72;
                margin-left: 5px;
            }

            .secure-badge {
                background: #f1f2f6;
                padding: 5px 15px;
                border-radius: 20px;
                display: inline-block;
            }
        </style>
    </head>
    <body>
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-5 col-lg-4">
                    <div class="login-card">
                        <div class="login-header text-center">
                            <span class="brand-logo">🍔</span>
                            <h1 class="h2 fw-bold mb-1" style="color: #2d3436;">Brasil <span style="color: #d63031;">Burger</span></h1>
                            <p class="text-muted fw-medium">Administration</p>
                        </div>

                        <div class="p-4 pt-2">
                            {% if error %}
                                <div class="alert alert-danger border-0 shadow-sm rounded-4" role="alert">
                                    <i class="bi bi-exclamation-circle-fill me-2"></i>
                                    {{ error.messageKey|trans(error.messageData, 'security') }}
                                </div>
                            {% endif %}

                            <form method="post" action="{{ path('app_login') }}">
                                <div class="mb-3">
                                    <label for="email" class="form-label small">
                                        <i class="bi bi-envelope-at me-1"></i> IDENTIFIANT
                                    </label>
                                    <input type="email" class="form-control" id="email" name="_username" value="{{ last_username }}" required autofocus placeholder="gestionnaire@brasilburger.com">
                                </div>

                                <div class="mb-4">
                                    <label for="password" class="form-label small">
                                        <i class="bi bi-key me-1"></i> MOT DE PASSE
                                    </label>
                                    <input type="password" class="form-control" id="password" name="_password" required placeholder="••••••••">
                                </div>

                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                                <div class="d-grid mb-2">
                                    <button type="submit" class="btn btn-danger btn-lg btn-login">
                                        Accéder au Grill <i class="bi bi-arrow-right-short ms-1"></i>
                                    </button>
                                </div>
                            </form>

                            <div class="text-center mt-4">
                                <div class="secure-badge">
                                    <small class="text-muted fw-bold">
                                        <i class="bi bi-shield-lock-fill text-success"></i> Zone Sécurisée
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <p class="text-white-50 small fw-medium">
                            &copy; 2024 Brasil Burger &bull; <span class="text-white">Projet L3 ISM</span>
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>