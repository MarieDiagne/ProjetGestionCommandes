<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Brasil Burger</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Catalogue" asp-action="Index">BRASIL BURGER</a>
                <div class="navbar-nav ms-auto">
                    <a class="nav-link" asp-controller="Panier" asp-action="Index">🛒 Panier</a>
                    @if (User.Identity?.IsAuthenticated ?? false) {
                        <a class="nav-link" asp-controller="Commande" asp-action="MesCommandes">Mes Commandes</a>
                        <a class="nav-link text-danger" asp-controller="Account" asp-action="Logout">Déconnexion (@User.Identity.Name)</a>
                    } else {
                        <a class="nav-link" asp-controller="Account" asp-action="Login">Connexion</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody() 
        </main>
    </div>

    <footer class="border-top footer text-muted text-center py-3">
        <div class="container">
            &copy; 2025 - Brasil Burger
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>