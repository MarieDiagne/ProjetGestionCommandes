{% extends 'base.html.twig' %}

{% block title %}Modifier le burger{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --burger-dark: #212529;
        --burger-red: #dc3545;
    }
    .form-card {
        transition: all 0.3s ease;
        border: 1px solid rgba(0,0,0,0.05) !important;
    }
    .form-label {
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #6c757d;
        margin-bottom: 0.5rem;
    }
    .form-control, .form-select {
        border: 2px solid #f8f9fa;
        padding: 0.75rem 1.25rem;
        background-color: #f8f9fa;
        transition: all 0.2s ease-in-out;
    }
    .form-control:focus, .form-select:focus {
        background-color: #fff;
        border-color: var(--burger-red);
        box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.1);
    }
    .btn-save {
        background-color: var(--burger-red);
        border: none;
        font-weight: 600;
        transition: transform 0.2s;
    }
    .btn-save:hover {
        background-color: #bb2d3b;
        transform: translateY(-1px);
    }
    .current-image-preview {
        border: 2px solid #f1f2f6;
        padding: 4px;
        background: #fff;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }
</style>
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb small">
                    <li class="breadcrumb-item"><a href="{{ path('app_burger_index') }}" class="text-muted">Burgers</a></li>
                    <li class="breadcrumb-item active text-danger fw-bold">Modification</li>
                </ol>
            </nav>

            <div class="card shadow-lg border-0 rounded-4 form-card">
                <div class="card-header bg-dark text-white p-4 border-0 rounded-top-4">
                    <div class="d-flex align-items-center">
                        <div class="bg-danger rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                            <i class="bi bi-pencil-fill fs-5"></i>
                        </div>
                        <div>
                            <h3 class="mb-0 fw-bold fs-4">Modifier le burger</h3>
                            <p class="text-white-50 mb-0 small text-uppercase fw-bold" style="letter-spacing: 1px;">
                                {{ burger.libelle }}
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="card-body p-4 p-lg-5">
                    <form method="POST" enctype="multipart/form-data">
                        {# Token de sécurité CSRF #}
                        <input type="hidden" name="_token" value="{{ csrf_token('edit_burger_' ~ burger.id) }}">

                        <div class="mb-4">
                            <label for="libelle" class="form-label">Nom du Burger</label>
                            <input type="text" name="libelle" id="libelle" class="form-control rounded-pill" value="{{ burger.libelle }}" required placeholder="Nom du burger">
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label for="prix" class="form-label">Prix (FCFA)</label>
                                <div class="input-group">
                                    <input type="number" name="prix" id="prix" class="form-control rounded-start-pill" value="{{ burger.prix }}" required>
                                    <span class="input-group-text rounded-end-pill bg-light border-0 fw-bold text-muted px-3">FCFA</span>
                                </div>
                            </div>
                            
                            <div class="col-md-6 mb-4">
                                <label for="categorie_id" class="form-label">Catégorie</label>
                                <select name="categorie_id" id="categorie_id" class="form-select rounded-pill">
                                    <option value="">Sélectionner une catégorie</option>
                                    {% for categorie in categories %}
                                        <option value="{{ categorie.id }}" {{ burger.categorie and burger.categorie.id == categorie.id ? 'selected' : '' }}>
                                            {{ categorie.nom }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="description" class="form-label">Description des ingrédients</label>
                            <textarea name="description" id="description" class="form-control rounded-4" rows="4" placeholder="Détails de la recette...">{{ burger.description }}</textarea>
                        </div>

                        <div class="mb-5 p-3 rounded-4 bg-light border border-white">
                            <label for="image" class="form-label">Mise à jour de l'image</label>
                            <input type="file" name="image" id="image" class="form-control rounded-pill border-0 shadow-sm">
                            
                            {% if burger.imageUrl %}
                                <div class="mt-3 d-flex align-items-center gap-3">
                                    <img src="{{ burger.imageUrl }}" alt="Aperçu" class="rounded-3 current-image-preview" style="height: 70px; width: 70px; object-fit: cover;">
                                    <div>
                                        <small class="text-muted d-block">Image actuelle enregistrée</small>
                                        <span class="badge bg-white text-dark border rounded-pill">Aperçu</span>
                                    </div>
                                </div>
                            {% endif %}
                        </div>

                        <div class="d-flex flex-column flex-sm-row gap-3 pt-2">
                            <button type="submit" class="btn btn-danger btn-save px-5 rounded-pill py-2 flex-grow-1">
                                <i class="bi bi-cloud-arrow-up-fill me-2"></i>Mettre à jour le burger
                            </button>
                            <a href="{{ path('app_burger_index') }}" class="btn btn-outline-secondary px-4 rounded-pill py-2">
                                <i class="bi bi-x-lg me-1"></i>Annuler
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}